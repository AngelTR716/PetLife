<?xml version="1.0" encoding="utf-8"?>
<!-- CardView: Contenedor que crea una tarjeta con bordes redondeados y sombra (efecto 3D) -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <!-- LinearLayout: Ordena los textos de la tarjeta uno debajo del otro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TextView principal: Mostrará el nombre de la mascota en texto grande y en negrita -->
        <TextView
            android:id="@+id/tvNombreMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la Mascota"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <!-- TextView secundario: Mostrará la especie y raza en texto más pequeño y gris -->
        <TextView
            android:id="@+id/tvEspecieRaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Especie - Raza"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>