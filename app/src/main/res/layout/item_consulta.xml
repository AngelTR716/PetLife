<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloConsulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consulta General"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1F2937" />

        <TextView
            android:id="@+id/tvFechaConsulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11/11/2026 10:00"
            android:textSize="12sp"
            android:textColor="#6B7280" />
    </LinearLayout>

    <!-- Botón chiquito para Editar -->
    <ImageButton
        android:id="@+id/btnEditarConsulta"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="#3B82F6"
        android:layout_marginEnd="8dp" />

    <!-- Botón chiquito para Eliminar -->
    <ImageButton
        android:id="@+id/btnEliminarConsulta"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="#EF4444" />
</LinearLayout>