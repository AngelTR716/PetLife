<?xml version="1.0" encoding="utf-8"?>
<!-- navigation: Es el contenedor principal que administra todas tus pantallas -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/listaMascotasFragment">
    <!-- startDestination indica que la Lista de Mascotas será la primera pantalla en abrirse -->

    <!-- Pantalla 1: Lista de Mascotas -->
    <fragment
        android:id="@+id/listaMascotasFragment"
        android:name="com.example.petlife.ui.ListaMascotasFragment"
        android:label="Mis Mascotas"
        tools:layout="@layout/fragment_lista_mascotas">

        <!-- action: Es la "flecha" o ruta que nos lleva a la pantalla de registro -->
        <action
            android:id="@+id/action_listaMascotasFragment_to_registroMascotaFragment"
            app:destination="@id/registroMascotaFragment" />

        <action
            android:id="@+id/action_listaMascotasFragment_to_perfilMascotaFragment"
            app:destination="@id/perfilMascotaFragment" />
    </fragment>

    <!-- Pantalla 2: Registro de Mascotas -->
    <fragment
        android:id="@+id/registroMascotaFragment"
        android:name="com.example.petlife.ui.RegistroMascotaFragment"
        android:label="Registrar Mascota"
        tools:layout="@layout/fragment_registro_mascota" />

    <!-- Pantalla 3: Perfil de Mascota -->
    <fragment
        android:id="@+id/perfilMascotaFragment"
        android:name="com.example.petlife.ui.PerfilMascotaFragment"
        android:label="Perfil de Mascota"
        tools:layout="@layout/fragment_perfil_mascota">

        <argument
            android:name="mascotaId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

</navigation>
